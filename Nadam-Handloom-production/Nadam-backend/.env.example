# Nandam Handlooms API v2 settings. Copy to .env and fill in. Never commit .env.
NODE_ENV=development            # development | test | production
PORT=4100

# PostgreSQL. In development, a LOCAL copy of the live database (never the live one).
DATABASE_URL=postgresql://USER@localhost:5432/nandam_dev

# Two different random secrets of at least 32 characters (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
JWT_STEP_SECRET=

# console = test mode: codes are printed in the log and shown in the app, nothing is sent.
#           Refused when NODE_ENV=production.
# messagecentral = real SMS through Message Central VerifyNow (needs the two values below).
# msg91 = MSG91 OTP with a DLT template (after DLT registration; needs the two MSG91 values).
SMS_PROVIDER=console
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_KEY=
MESSAGE_CENTRAL_CODE_TTL_SECONDS=60  # = "Validity Time" in the Message Central dashboard
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Website (W1: customer sign-in). A third random secret, different from the two above.
JWT_SHOP_ACCESS_SECRET=
# The website's own addresses, comma separated (required in production), e.g.
# https://new.nandamhandlooms.com. Development default: http://localhost:5180
SHOP_WEB_ORIGINS=
SHOP_COOKIE_SECURE=             # true in production (default), false for http://localhost
SHOP_SMS_DAILY_LIMIT=500        # website codes per day, all numbers together (abuse safety net)
# The website's built index.html: saree links then preview with the saree's own photo, name and
# price (WhatsApp, Facebook...). Live: /var/www/nandam-web/dist/index.html. Empty: general preview.
SHOP_WEB_INDEX=
PUSH_PROVIDER=                  # fcm (default when the Firebase server values are set) | console

TRUST_PROXY=1                   # proxies in front of the app (nginx = 1)
LOG_REQUESTS=true               # logs method, path, status and time only (never bodies)
RATE_LIMIT_PER_MINUTE=60        # per-IP limit on sign-in routes; the shop Wi-Fi shares one IP

# Photos and catalogue PDFs (Module 3).
#   local = a folder on this machine, served at /uploads (development). Never deletes a file it didn't create,
#           so working on a copy of the live data can't remove live photos.
#   s3    = the shop's Amazon S3 bucket (production; refused: local in production).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads
PUBLIC_URL=http://192.168.0.4:4100   # how phones reach this server (for /uploads links)
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=                     # leave empty on EC2 to use the instance role
S3_SECRET_ACCESS_KEY=
WEBSITE_URL=                          # e.g. https://<shop website>, for old /images/... photo paths

# Invoices (Module 5). Optional: these are the defaults, same as the old backend.
# COMPANY_NAME=Nandam Handlooms
# COMPANY_ADDRESS=Hussain Katta, Mangalagiri, Andhra Pradesh, 522503, India
# COMPANY_MOBILE=+919494170180
# COMPANY_GSTIN=37CCWPN2487C1Z2
# GST_RATE_PERCENT=5                  # included in every price

# --- Firebase (push and web push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_WEB_VAPID_KEY=

# Website W6: online payment with Razorpay (the same account as the old backend).
# Payments stay off until PAYMENTS_ENABLED=true. Test keys (rzp_test_) take no money.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The webhook secret set in the Razorpay dashboard (the existing webhook is reused).
RAZORPAY_WEBHOOK_SECRET=
# IGST for online orders delivered outside SHOP_STATE: true after the accountant confirms.
GST_IGST_OTHER_STATES=false
SHOP_STATE=Andhra Pradesh
# The most one online payment may be (rupees, Razorpay's limit on the account).
PAYMENTS_MAX_AMOUNT=500000
# While trying payments on the live website: only these customers' mobiles see Checkout
# (comma-separated); everyone else orders on WhatsApp. Empty = every customer. Test keys on
# the live server need it (and PAYMENTS_ALLOW_TEST_KEYS_IN_PRODUCTION=true).
PAYMENTS_TESTERS=
# Or test payment for every visitor, on purpose, while the website is being built (the website
# then says "Test payment: no real money"). Never with live keys.
PAYMENTS_TEST_FOR_EVERYONE=false

# Admin app notifications (owners: each online payment, refunds). Android phones use the
# Firebase settings above. iPhones use Apple's push service: a push key (.p8) from the Apple
# Developer account (Keys → Apple Push Notifications service), on one line with \n breaks.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.nandamhandlooms.staff
APNS_PRODUCTION=true
