# ─────────────────────────────────────────────────────────────────────
# Nandam Handlooms — backend configuration
#
# Copy to .env and fill in. Everything the app needs is listed here; if a
# value is missing the server either refuses to start (required) or logs
# exactly which feature is disabled (optional) — see config/startupChecks.ts.
#
# Nothing is read from outside this file. In particular AWS credentials are
# read from S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY below, NOT from
# ~/.aws/credentials, so a checkout behaves the same on every machine.
# ─────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Postgres. DIRECT_URL is the non-pooled connection Prisma migrations use
# (Neon and other poolers need both).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# At least 16 characters each. Generate with:  openssl rand -base64 32
JWT_ACCESS_SECRET="change-me-at-least-16-chars"
JWT_REFRESH_SECRET="change-me-at-least-16-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# Customer web origin. Also used to build product links in the staff app's
# WhatsApp shipment message, so point it at the real site in production.
FRONTEND_URL="http://localhost:5173"
# Optional extra CORS origins, comma-separated (e.g. a LAN address).
# CORS_ALLOWED_ORIGINS="http://192.168.1.10:5173"

# ── Image / PDF storage ──────────────────────────────────────────────
# console = no uploads possible (default, placeholder only)
# local   = files on disk, served from this API — works on any machine with
#           no cloud account. Use this for development.
# s3      = production
STORAGE_PROVIDER=local

# STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads
# Absolute URL this API is reachable at, used to build image URLs. Set it to
# your machine's LAN address if the staff app on a phone must load them.
# PUBLIC_API_URL="http://192.168.1.10:4000"

# STORAGE_PROVIDER=s3 — all four are needed for uploads to work.
# S3_BUCKET_NAME="your-bucket"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
# Optional: CDN/custom domain in front of the bucket.
# S3_PUBLIC_URL="https://your-bucket.s3.ap-south-1.amazonaws.com"

# ── Payments (Razorpay) ──────────────────────────────────────────────
# Without these, checkout returns 503 PAYMENT_NOT_CONFIGURED.
# Use rzp_test_* keys outside production.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
# Separate secret from the Razorpay dashboard's webhook settings — NOT the
# key secret above. Without it the webhook endpoint stays disabled and
# payment confirmation relies solely on the browser callback, which is lost
# if the customer closes the tab mid-payment. Set this in production.
# RAZORPAY_WEBHOOK_SECRET="xxxxxxxx"

# ── SMS / OTP ────────────────────────────────────────────────────────
# console = OTPs printed to the server log (fine for development)
SMS_PROVIDER=console
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID=""
# MSG91_TEMPLATE_ID=""

# ── Bootstrap admin (optional; used by `npm run seed`) ────────────────
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_MOBILE="9999999999"
SEED_ADMIN_MPIN="000000"

# ── Business / invoicing (optional — defaults match the registration) ─
# GST_RATE_PERCENT=5
# COMPANY_NAME="Nandam Handlooms"
# COMPANY_ADDRESS="Hussain Katta, Mangalagiri, Andhra Pradesh, 522503, India"
# COMPANY_MOBILE="+919494170180"
# COMPANY_GSTIN="37CCWPN2487C1Z2"
# COMPANY_LOGO_URL="https://nandamhandlooms-media.s3.ap-south-1.amazonaws.com/site/brand/logo.png"

# 10 unique letters mapping to digits 0-9 for coded price tags. Change this
# in production so a stranger cannot read prices off a tag.
PRICE_CODE_WORD=BLACKHORSE
