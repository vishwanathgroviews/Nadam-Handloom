PORT=3000
NODE_ENV=development

# PostgreSQL connection strings (Neon). Get these from your Neon project dashboard
# ("Connect" button). DATABASE_URL should use the pooled (PgBouncer) endpoint for
# runtime queries; DIRECT_URL uses the non-pooled endpoint for migrations.
# If you only have one connection string, use it for both.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# JWT secrets — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use two DIFFERENT values. Never reuse these across environments.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
# Kept short deliberately — after this expires, both apps drop back to their
# existing MPIN-login screen rather than staying signed in indefinitely.
JWT_REFRESH_EXPIRES_IN="1d"

# OTP delivery provider for the mobile app's and customer web's phone
# verification. "console" (default) logs the OTP to the server console and
# echoes it in the API response — dev/test only.
SMS_PROVIDER="console"
# Real provider — set SMS_PROVIDER="msg91" plus the two required values
# below once real MSG91 credentials + a DLT-approved template exist
# (see providers/sms/msg91.provider.ts). Until then this whole block is
# ignored and OTPs keep flowing through the console/dev-echo path above.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Optional one-time bootstrap ADMIN account for the mobile app.
# Only created by `npm run prisma:seed` if ALL FOUR are set and no ADMIN exists yet.
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_MOBILE=
# SEED_ADMIN_MPIN=

# Razorpay (customer web checkout). Get these from the Razorpay dashboard
# (Settings > API Keys). Without these, checkout returns a clear
# "payment gateway not configured" error instead of failing unexpectedly.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Razorpay webhook (Settings > Webhooks > add endpoint pointing at
# /api/v1/webhooks/razorpay, subscribe to "payment.captured", copy the
# secret it generates here). A DIFFERENT secret from RAZORPAY_KEY_SECRET
# above. This is the source-of-truth finalization path — the browser
# callback (verifyPayment) still works standalone if this isn't set, but
# a customer who closes the tab mid-checkout won't get their order
# finalized without it.
# RAZORPAY_WEBHOOK_SECRET=

# DTDC order tracking is fully manual by design — no courier API integration.
# Admin/staff enter the AWB and mark shipped/delivered by hand; the customer
# is shown the AWB plus a link to DTDC's public tracking page and looks up
# status there themselves. Nothing to configure here.

# Product image storage. "console" (default) logs uploads and refuses to
# serve them — dev/test only; the admin app's image upload returns a clear
# "not configured" error until STORAGE_PROVIDER=s3 is set with a real bucket.
STORAGE_PROVIDER="console"
# S3_BUCKET_NAME=
# S3_REGION=
# Optional: a CDN/custom domain in front of the bucket. Defaults to the
# bucket's own https://<bucket>.s3.<region>.amazonaws.com URL.
# S3_PUBLIC_URL=
# Credentials come from the AWS CLI's default profile (`aws configure`) or
# an attached IAM role — no AWS_ACCESS_KEY_ID/SECRET env vars needed here.

# Letter-substitution cipher for "coded price" labels (10 unique letters,
# one per digit 0-9). Change this in production — anyone who knows the word
# can read prices off a tag meant to hide them.
PRICE_CODE_WORD="BLACKHORSE"

FRONTEND_URL="http://localhost:5173"
# Extra CORS-allowed origins besides FRONTEND_URL, comma-separated — e.g. a
# dev machine's LAN address (http://192.168.1.5:5173) so customer-web can be
# opened directly from another device's browser too. Usually unnecessary:
# customer-web's own dev server proxies /api to this backend (see its
# vite.config.js), so most LAN testing never triggers browser CORS at all.
# CORS_ALLOWED_ORIGINS=
