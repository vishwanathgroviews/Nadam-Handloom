# Environment for the DEPLOYED backend (AWS App Runner / ECS / any container
# host). Set these as the service's environment variables — do not ship a .env
# file in the image (.dockerignore excludes it).
#
# Differences from local .env are called out below; anything not mentioned
# behaves the same as in development.

NODE_ENV=production
# App Runner routes to 8080 by default; the Dockerfile already defaults to it.
PORT=8080

# ── Database (Neon) ───────────────────────────────────────────────────────
# Same Neon project as development, or a separate production branch/database.
# DATABASE_URL is the pooled endpoint; DIRECT_URL the non-pooled one, used by
# `prisma migrate deploy`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────────────────
# MUST be new values, not the development ones. Two different long random
# strings: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-differently"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="1d"

# ── CORS ──────────────────────────────────────────────────────────────────
# The customer web's real origin. The staff APK is a native app and sends no
# Origin header, so it is unaffected by these.
FRONTEND_URL="https://shop.example.com"
# Optional extra origins, comma-separated (e.g. a staging site).
# CORS_ALLOWED_ORIGINS="https://staging.example.com"

# ── S3 (product images, invoices, catalog PDFs) ───────────────────────────
STORAGE_PROVIDER="s3"
S3_BUCKET_NAME="nandamhandlooms-media"
S3_REGION="ap-south-1"
#
# IMPORTANT — this is the one that bites on first deploy. Locally the AWS SDK
# picks up ~/.aws/credentials; a container has no such file. Either:
#   (a) attach an IAM instance role to the service (preferred — no long-lived
#       keys anywhere), and set nothing here; or
#   (b) set explicit keys, which the SDK's default chain reads first:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── SMS / OTP ─────────────────────────────────────────────────────────────
# "console" only logs the code to the server log, and the dev echo in the API
# response is disabled when NODE_ENV=production — so with console set, nobody
# can complete staff activation or customer registration. Real credentials are
# required before onboarding anyone new. Existing MPIN logins keep working.
SMS_PROVIDER="msg91"
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ── Razorpay ──────────────────────────────────────────────────────────────
# Live keys for real payments; test keys stay in the development environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Now worth setting: with a public URL, Razorpay can reach the webhook. Point
# it at https://<your-domain>/api/v1/webhooks/razorpay, subscribe to
# "payment.captured", and paste the secret it generates here. Without it, a
# customer who closes the tab mid-payment leaves the order unfinalized.
RAZORPAY_WEBHOOK_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────
# Change from the default — anyone who knows the word can read the coded
# prices off a printed tag.
PRICE_CODE_WORD="BLACKHORSE"

# Company/GST details already default to the real registration; override only
# if something changes.
# GST_RATE_PERCENT=5
# COMPANY_NAME=
# COMPANY_GSTIN=
