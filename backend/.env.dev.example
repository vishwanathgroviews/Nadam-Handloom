# ─────────────────────────────────────────────────────────────────────
# Nandam Handlooms — LOCAL DEVELOPMENT settings (ready to use)
#
#   cd backend && cp .env.dev.example .env
#
# Then change only DATABASE_URL / DIRECT_URL to match your local
# PostgreSQL (see docs/LOCAL_SETUP.md). Nothing in this file is a
# production secret, and production values must never be committed.
# ─────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Your local PostgreSQL 18 database, e.g.
#   Postgres.app (Mac):  postgresql://<your-mac-username>@localhost:5432/nandam_dev
#   Windows installer:   postgresql://postgres:<your-password>@localhost:5432/nandam_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nandam_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nandam_dev"

# Local-only token secrets (any value of 16+ characters works locally).
JWT_ACCESS_SECRET="local-dev-access-secret-not-for-production"
JWT_REFRESH_SECRET="local-dev-refresh-secret-not-for-production"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# Customer website dev server.
FRONTEND_URL="http://localhost:5173"

# Testing from your phone on the same Wi-Fi: replace 192.168.1.20 with your
# laptop's LAN address and uncomment both lines.
# CORS_ALLOWED_ORIGINS="http://192.168.1.20:5173"
# PUBLIC_API_URL="http://192.168.1.20:4000"

# Photos, invoices and catalogue PDFs are saved on this laptop in
# backend/uploads/ (git-ignored) — no cloud account needed.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads
# Only used by `npm run prisma:seed` to point demo products at the public
# demo photos. Uploads still go to the local folder above.
S3_BUCKET_NAME="nandamhandlooms-media"
S3_REGION="ap-south-1"

# OTPs are printed in the backend terminal and, in development, also shown
# on screen in the apps. No SMS is sent.
SMS_PROVIDER=console

# Online payments (optional): create your own free Razorpay account, switch
# it to Test Mode, and paste its rzp_test_ keys here to try checkout.
# Without them, website checkout returns "payments not configured".
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."

# Only used when starting from an EMPTY database (`npm run prisma:seed`).
SEED_ADMIN_NAME="Dev Admin"
SEED_ADMIN_EMAIL="dev.admin@example.com"
SEED_ADMIN_MOBILE="9999999999"
SEED_ADMIN_MPIN="000000"
