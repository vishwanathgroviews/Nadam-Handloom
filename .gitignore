node_modules
# Keep environment variables out of version control
.env

/generated/prisma

# Source photography — 208MB of full-resolution shots (20MB+ each) kept for
# editing. Git stores every version of a binary forever, so committing these
# would permanently bloat the repo and make every clone, the deploy server's
# included, download all of it. What the site actually serves is already in
# the S3 media bucket; the only code references to this folder are comments.
# Back these up somewhere built for large files, not here.
Images/

# ── Secrets ──────────────────────────────────────────────────────────
# .env is already ignored above; these cover the variants a local setup
# tends to grow (.env.local, .env.production, per-workspace copies) while
# keeping the committed *.env.example templates visible.
.env.*
!.env.example
!.env.*.example
*.local

# Keys, certificates and signing material — never belongs in the repo.
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
id_rsa*
*service-account*.json
.aws/
credentials

# ── Editor / tooling state ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# AI assistant scratch state — local to a machine, not project source.
.claude/
CLAUDE.md
.mcp.json

# Built APKs — distributed via S3/EAS, never committed (107 MB each).
*.apk

# Throwaway test bundle (built against the live API for browser checks).
frontend/customer-web/dist-test/

# Scratch output from one-off render checks.
backend/.tmp/
