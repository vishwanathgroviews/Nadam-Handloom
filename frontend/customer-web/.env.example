# Backend API origin (no trailing slash, no /api/v1 suffix — that's appended
# automatically). Vite only exposes env vars prefixed VITE_ to client code,
# and inlines them at BUILD time — set this in your deploy environment
# before running `npm run build`.
#
# Leave UNSET for local dev: the app then calls a relative '/api/v1', which
# Vite's dev server proxies to the backend (see vite.config.js) — this works
# from any device on the LAN, not just the dev machine itself. Only set this
# when the frontend and backend are deployed on different origins (no dev
# proxy in front of a production build).
# VITE_API_URL=https://api.example.com

# Base URL for static site imagery (hero, category, craft, brand — anything
# not served through the catalog API, which already returns full S3 URLs).
# Defaults to the real S3 bucket, so this only needs setting if the bucket,
# region, or a CDN in front of it ever changes.
VITE_MEDIA_BASE_URL=https://nandamhandlooms-media.s3.ap-south-1.amazonaws.com/site
