{
  "expo": {
    "name": "Nandam Handlooms Staff",
    "slug": "nandam-handlooms",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nandamhandlooms.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan product barcodes for lookup and in-store sales.",
        "NSPhotoLibraryUsageDescription": "Used to add a photo to a product listing."
      },
      "buildNumber": "6",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nandamhandlooms.staff",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C1420"
      },
      "versionCode": 25
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan product barcodes for lookup and in-store sales.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to add a photo to a product listing.",
          "microphonePermission": false,
          "cameraPermission": "Used to take a photo for a product listing."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A1F2B"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#5C1420"
        }
      ],
      "./plugins/withWhatsAppQueries"
    ],
    "extra": {
      "eas": {
        "projectId": "23fffe49-44ca-40e0-ab15-083196d5b3eb"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "groviews.com"
  }
}
