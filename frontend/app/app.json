{
  "expo": {
    "name": "Nandam Handlooms Staff",
    "slug": "nandam-handlooms-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nandamhandlooms.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan product barcodes for lookup and in-store sales.",
        "NSPhotoLibraryUsageDescription": "Used to add a photo to a product listing."
      }
    },
    "android": {
      "package": "com.nandamhandlooms.staff",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C1420"
      },
      "versionCode": 21
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan product barcodes for lookup and in-store sales."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to add a photo to a product listing."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A1F2B"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#5C1420"
        }
      ],
      "./plugins/withWhatsAppQueries"
    ],
    "extra": {
      "eas": {
        "projectId": "d589c987-90a9-4369-b777-84e2e8fc6b44"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "siddartha78"
  }
}
