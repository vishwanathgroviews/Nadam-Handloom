{
  "expo": {
    "name": "Nandam Handlooms Staff",
    "slug": "nandam-handlooms-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nandamhandlooms.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan product barcodes for lookup and in-store sales.",
        "NSPhotoLibraryUsageDescription": "Used to add a photo to a product listing."
      }
    },
    "android": {
      "package": "com.nandamhandlooms.staff",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C1420"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan product barcodes for lookup and in-store sales."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to add a photo to a product listing."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A1F2B"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3f1e6196-d244-4e12-9993-ca68992aa9b6"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5C1420"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
